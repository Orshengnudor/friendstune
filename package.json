{
  "name": "friendstune",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "cd packages/web && bunx vite",
    "build": "turbo build",
    "build:web": "cd packages/web && bunx vite build",
    "typecheck": "turbo typecheck",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "db:push": "turbo db:push"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "turbo": "2.9.18",
    "typescript": "7.0.1-rc"
  }
}
